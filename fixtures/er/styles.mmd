erDiagram
    CAR {
        string registrationNumber
        string make
    }
    PERSON:::foo ||--|| CAR : owns
    PERSON o{--|| HOUSE:::bar : has
    subgraph rental
        AGENCY ||--o{ NAMED-DRIVER : allows
    end

    classDef default fill:#f9f,stroke-width:4px
    classDef foo stroke:#f00
    classDef bar stroke:#0f0
    classDef hired stroke:#90f
    class NAMED-DRIVER hired
    style CAR fill:#bbf,color:#fff,stroke-dasharray: 5 5
    style rental stroke:#00f,stroke-width:4px
