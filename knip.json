{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/index.ts",
        "src/cli/main.ts",
        "scripts/claude-passthrough.ts",
        "scripts/sgr-attributes.ts"
      ],
      "project": [
