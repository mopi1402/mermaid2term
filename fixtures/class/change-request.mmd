classDiagram
    class ChangeRequest {
      +id: UUID
      +status: String
      +createdAt: DateTime
    }
    class ApprovalPolicy {
      +evaluate()
      +explain()
    }
    class ExecutionService {
      +plan()
      +dispatch()
    }
    class ExecutionStep {
      +name: String
      +owner: String
      +deadline: DateTime
    }
    class AuditEvent {
      +kind: String
      +payload: Json
    }
    ChangeRequest --> ApprovalPolicy : checks
    ChangeRequest --> ExecutionService : executes
    ExecutionService --> ExecutionStep : emits
    ExecutionStep --> AuditEvent : records
