classDiagram
    direction LR
    class Student {
        -idCard : IdCard
    }
    class IdCard {
        -id : int
        -name : string
    }
    class Bike {
        -id : int
        -name : string
    }
    Customer "0..1" --> "1..*" Ticket
    Order "1" *-- "custom" Line
    Student "1..n" --o "1" IdCard : carries
    Student "1..n" --o "1" Bike : rides
    Galaxy --> "many" Star : Contains
